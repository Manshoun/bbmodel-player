{
  "name": "bbmodel-player",
  "version": "0.1.0",
  "description": "Load and play Blockbench .bbmodel files (models + animations) in any website. One script tag, one HTML element.",
  "homepage": "https://manshoun.github.io/bbmodel-player/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manshoun/bbmodel-player.git"
  },
  "bugs": "https://github.com/Manshoun/bbmodel-player/issues",
  "type": "module",
  "main": "./dist/bbmodel-player.core.js",
  "module": "./dist/bbmodel-player.core.js",
  "exports": {
    ".": "./dist/bbmodel-player.core.js",
    "./standalone": "./dist/bbmodel-player.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "dev": "node scripts/build.mjs --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "blockbench",
    "bbmodel",
    "minecraft",
    "threejs",
    "web-component",
    "3d",
    "animation",
    "viewer"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "three": "0.170.0"
  }
}
